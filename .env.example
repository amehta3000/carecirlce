# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for the Google token table and nothing else. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Who may sign in at all (comma-separated Google emails) ----
# Defense in depth on top of care-circle membership. Leave empty to rely on
# invites alone, but setting it is recommended.
ALLOWED_EMAILS=you@gmail.com,brother@gmail.com,dad@gmail.com

# ---- Public URL of the app (used for OAuth redirects and calendar links) ----
APP_URL=http://localhost:3000

# ---- Google OAuth client for the Calendar connection ----
# Same Google Cloud project as Supabase's Google login is fine.
# Add redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Generate with: npm run gen-key
TOKEN_ENCRYPTION_KEY=

# ---- Anthropic (reads the discharge papers) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
